# =====================================================================
# Honeytrap SIEM configuration
# Copy this file to .env and replace every <PLACEHOLDER>.
# .env is git-ignored; never commit real values.
# =====================================================================

# ---- Dashboard login ------------------------------------------------
SIEM_ADMIN_USER=<SIEM_ADMIN_USER>
SIEM_ADMIN_PASSWORD=<SIEM_ADMIN_PASSWORD>
# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SIEM_SECRET_KEY=<SIEM_SECRET_KEY>

# Where the dashboard listens. 127.0.0.1 = this PC only, 0.0.0.0 = whole LAN.
SIEM_BIND=127.0.0.1
SIEM_PORT=5000

# ---- Honeypot VM (where pipeline.py pulls logs from over SFTP) -------
HONEYPOT_HOST=<HONEYPOT_VM_IP>
# Real SSH port of the VM itself (port 22 is taken by the honeypot)
HONEYPOT_SFTP_PORT=2222
HONEYPOT_SFTP_USER=<HONEYPOT_VM_USER>
HONEYPOT_SFTP_PASSWORD=<HONEYPOT_VM_PASSWORD>
# Folder on the VM that holds ssh.json and web.json, e.g. <dir>/honeypot/logs
HONEYPOT_LOG_DIR=<HONEYPOT_LOG_DIR>

# Listener ports of the two sensors (shown in the UI, also read by the sensors)
HONEYPOT_SSH_PORT=22
HONEYPOT_WEB_PORT=8080

# ---- Pipeline -------------------------------------------------------
PIPELINE_INTERVAL=5
# Optional overrides (defaults live inside siem/):
# SIEM_DB_PATH=<dir>/siem.db
# PIPELINE_LOCAL_DIR=<dir>/synced_logs
# PIPELINE_OFFSETS=<dir>/offsets.json
